# MySQL Database Configuration
# Copy this file to .env and update with your actual credentials
# WARNING: Never commit .env file to version control

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here

# Optional: Database names (defaults below)
BRONZE_DB=bronze
SILVER_DB=silver
GOLD_DB=gold

# Optional: Data paths
DATA_PATH=./datasets

# Optional: Logging
LOG_LEVEL=INFO
